{
  "name": "pebble-approvals",
  "author": "Lee Boonstra (@savelee)",
  "version": "1.2.0",
  "description": "Approve your coding agent (like Antigravity) from your wrist, with the Pebble Time 2 app (and web extension). Companion listener: https://github.com/savelee/pebble_coding_agent_approval",
  "keywords": [
    "pebble-app",
    "ai",
    "antigravity",
    "cursor",
    "developer-tools",
    "approvals",
    "notifications"
  ],
  "private": false,
  "dependencies": {},
  "pebble": {
    "displayName": "Agent Approvals",
    "uuid": "f88fb1ff-02bf-48f8-819e-e6832cf137a9",
    "sdkVersion": "3",
    "watchapp": {
      "watchface": false
    },
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "emery",
      "chalk",
      "diorite",
      "aplite"
    ],
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "ACTION",
      "STATUS",
      "HOST",
      "PORT",
      "PROMPT_TEXT"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_APP_ICON",
          "file": "images/app_icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
