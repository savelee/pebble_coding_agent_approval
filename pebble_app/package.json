{
  "name": "pebble-approvals",
  "author": "Lee Boonstra (@savelee)",
  "version": "1.1.0",
  "description": "Approve your coding agent (like Antigravity) from your wrist, with the Pebble Time 2 app (and web extension). Companion listener: https://github.com/savelee/pebble_coding_agent_approval",
  "keywords": [
    "pebble-app",
    "ai",
    "antigravity",
    "cursor",
    "developer-tools",
    "approvals"
  ],
  "private": false,
  "dependencies": {},
  "pebble": {
    "displayName": "Agent Approvals",
    "uuid": "4c1d6837-1234-4a25-9c88-75c123456789",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "emery",
      "chalk",
      "diorite"
    ],
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "ACTION",
      "STATUS",
      "HOST",
      "PORT"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_ANTIGRAVITY_LOGO",
          "file": "images/antigravity_logo_watch.png"
        },
        {
          "type": "png",
          "name": "IMAGE_APP_ICON",
          "file": "images/app_icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
